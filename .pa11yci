{
  "defaults": {
    "standard": "WCAG2AA",
    "runners": [
      "axe",
      "htmlcs"
    ],
    "timeout": 30000,
    "wait": 250,
    "chromeLaunchConfig": {
      "args": [
        "--no-sandbox",
        "--disable-setuid-sandbox"
      ]
    }
  },
  "urls": [
    "http://127.0.0.1:8080/",
    "http://127.0.0.1:8080/en/"
  ]
}

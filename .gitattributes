# Normalize text files while preserving explicit line endings
* text=auto

# Web and documentation files
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf
*.svg  text eol=lf

# Binary assets
*.png  -text
*.jpg  -text
*.jpeg -text
*.webp -text
*.ico  -text
*.gif  -text
